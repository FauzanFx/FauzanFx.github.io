---
import '../styles/global.css';
import { getCollection, render } from 'astro:content';

const projects = await getCollection('projects');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Portfolio - Fauzan Febriansyah</title>
    <style>
      body { background: white !important; color: black !important; font-family: sans-serif; }
      @media print {
        @page { margin: 1.5cm; }
        .page-break { break-after: always; }
        .avoid-break { break-inside: avoid; }
      }
    </style>
  </head>
  <body class="bg-white text-gray-900 p-8 max-w-5xl mx-auto">
    <!-- Hero Section -->
    <header class="mb-12 border-b-2 border-gray-200 pb-8">
      <h1 class="text-5xl font-extrabold mb-2 text-gray-900">Fauzan Febriansyah</h1>
      <h2 class="text-2xl text-cyan-700 font-semibold mb-4">IoT & Embedded Engineer</h2>
      <p class="text-gray-700 leading-relaxed max-w-3xl">
        I'm an undergraduate student in Internet Engineering Technology with a strong focus on digital infrastructure and IoT development. I specialize in networking, embedded systems, and system architecture.
      </p>
    </header>

    <!-- Skills Section -->
    <section class="mb-12 avoid-break">
      <h3 class="text-2xl font-bold border-b border-gray-300 mb-4 pb-2 text-gray-900">Core Competencies</h3>
      <div class="grid grid-cols-3 gap-6">
        <div>
          <h4 class="font-bold mb-2">Embedded & Hardware</h4>
          <ul class="list-disc pl-5 text-gray-700 text-sm">
            <li>STM32, ESP32, Arduino</li>
            <li>Pixhawk & MAVLink</li>
            <li>PID Control Systems</li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold mb-2">IoT & Networking</h4>
          <ul class="list-disc pl-5 text-gray-700 text-sm">
            <li>MQTT, UDP/TCP, HTTP</li>
            <li>MikroTik Routing (MTCNA)</li>
            <li>Docker & Kubernetes</li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold mb-2">Software & Tools</h4>
          <ul class="list-disc pl-5 text-gray-700 text-sm">
            <li>C/C++, Python</li>
            <li>YOLO, OpenCV, Roboflow</li>
            <li>Git & AI-Agentic Tools</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Projects Detailed Section -->
    <section>
      <h3 class="text-3xl font-bold border-b-2 border-gray-900 mb-8 pb-2">Project Details</h3>
      <div class="space-y-12">
        {projects.map(async (project) => {
          const { Content } = await render(project);
          return (
            <div class="project-item avoid-break mb-12">
              <h4 class="text-2xl font-bold text-cyan-800 mb-1">{project.data.title}</h4>
              <p class="italic text-gray-600 mb-4">{project.data.role} | {project.data.period}</p>
              
              <!-- Content -->
              <div class="prose prose-slate max-w-none text-gray-800 mb-6 prose-headings:text-gray-900 prose-a:text-cyan-700 prose-h2:text-xl prose-h2:font-bold prose-h2:mt-4 prose-h2:mb-2 prose-ul:pl-5 prose-ul:list-disc">
                <Content />
              </div>

              <!-- Gallery -->
              {project.data.gallery && project.data.gallery.length > 0 && (
                <div class="grid grid-cols-2 gap-4 avoid-break mt-6">
                  {project.data.gallery.slice(0, 4).map(img => (
                    <img src={img} class="w-full h-48 object-cover rounded-lg border border-gray-200 shadow-sm" />
                  ))}
                </div>
              )}
              <div class="page-break"></div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Speaking Experience (Simplified) -->
    <section class="avoid-break mt-8">
      <h3 class="text-2xl font-bold border-b border-gray-300 mb-6 pb-2 text-gray-900">Speaking & MC Experience</h3>
      <ul class="list-disc pl-5 text-gray-700 space-y-2">
        <li><strong>MC - Pionir Gadjah Mada:</strong> Master of Ceremonies for UGM's official campus orientation event.</li>
        <li><strong>MC - Graduation Ceremony:</strong> Hosted the university's graduation ceremony events.</li>
        <li><strong>Poetry Reader - Peksimiprov UGM:</strong> Performed poetry reading at the provincial student art week.</li>
        <li><strong>Speaker - KMFM Nyala:</strong> Shared insights and experiences at the KMFM Nyala session.</li>
        <li><strong>Speaker - Public Speaking KMK:</strong> Gave training on effective public speaking at KMK.</li>
        <li><strong>Speaker - UKM Selam:</strong> Delivered a talk for the University Diving Club.</li>
      </ul>
    </section>
  </body>
</html>
