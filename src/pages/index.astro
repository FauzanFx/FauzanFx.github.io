---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Fauzan Febriansyah | IoT & Embedded Engineer">
  <main class="max-w-5xl mx-auto px-6 py-12 md:py-24">
    <!-- HERO SECTION -->
    <section id="hero" class="flex flex-col md:flex-row items-center gap-12 mb-24">
      <div class="flex-1 space-y-6">
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white mb-6">
          Hi, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-emerald-400">Fauzan Febriansyah</span>.
        </h1>
        <p class="text-lg text-gray-400 leading-relaxed max-w-2xl">
          I'm an undergraduate student in Internet Engineering Technology with a strong focus on 
          <span class="text-gray-200 font-medium"> digital infrastructure </span>and <span class="text-gray-200 font-medium">IoT development</span>. 
          I specialize in <span class="text-gray-200 font-medium">networking, embedded systems, and system architecture</span>. 
          As an adaptable and curious learner, I thrive in multidisciplinary teams to solve complex engineering challenges and build robust technological solutions.
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-4">
          <a href="/CV_Fauzan_Febriansyah.pdf" download="CV_Fauzan_Febriansyah.pdf" target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-cyan-500 hover:bg-cyan-600 text-gray-900 font-bold rounded-lg transition-colors flex items-center gap-2 shadow-lg shadow-cyan-500/20">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Download CV
          </a>
          <a href="#projects" class="px-6 py-3 border border-gray-700 hover:border-gray-500 text-gray-300 rounded-lg transition-colors">
            View Projects
          </a>
          <a href="https://www.linkedin.com/in/fauzan-febriansyah-8269512a2/" target="_blank" rel="noopener noreferrer" class="p-3 bg-gray-800 hover:bg-blue-600 text-gray-300 hover:text-white rounded-lg transition-colors border border-gray-700 hover:border-blue-500" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
        </div>
      </div>
      <div class="w-48 h-48 md:w-72 md:h-72 shrink-0">
        <!-- Avatar -->
        <div class="w-full h-full rounded-full border-4 border-gray-800 bg-gray-800 flex items-center justify-center overflow-hidden relative group shadow-2xl">
          <img src="/images/profile.png" alt="Fauzan Febriansyah" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
        </div>
      </div>
    </section>

    <!-- SKILLS SECTION -->
    <section id="skills" class="mb-24">
      <h2 class="text-2xl font-bold text-white mb-8 flex items-center gap-2">
        <span class="text-cyan-400">#</span> Core Competencies
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-gray-800/50 border border-gray-700/50 p-6 rounded-xl hover:border-cyan-500/30 transition-colors">
          <h3 class="text-lg font-semibold text-white mb-4">Embedded & Hardware</h3>
          <ul class="space-y-2 text-gray-400">
            <li>STM32, ESP32, Arduino</li>
            <li>Pixhawk & MAVLink</li>
            <li>PID Control Systems</li>
            <li>Sensor Integrations</li>
          </ul>
        </div>
        <div class="bg-gray-800/50 border border-gray-700/50 p-6 rounded-xl hover:border-cyan-500/30 transition-colors">
          <h3 class="text-lg font-semibold text-white mb-4">IoT & Networking</h3>
          <ul class="space-y-2 text-gray-400">
            <li>MQTT, UDP/TCP, HTTP</li>
            <li>MikroTik Routing (MTCNA)</li>
            <li>Docker & Kubernetes</li>
            <li>Linux (Ubuntu)</li>
          </ul>
        </div>
        <div class="bg-gray-800/50 border border-gray-700/50 p-6 rounded-xl hover:border-cyan-500/30 transition-colors">
          <h3 class="text-lg font-semibold text-white mb-4">Software & Tools</h3>
          <ul class="space-y-2 text-gray-400">
            <li>C/C++, Python</li>
            <li>YOLO, OpenCV, Roboflow</li>
            <li>GitHub & Version Control</li>
            <li>AI-Agentic Tools (Antigravity, Codex)</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- FEATURED PROJECTS PREVIEW -->
    <section id="projects" class="mb-24">
      <div class="flex justify-between items-end mb-8">
        <h2 class="text-2xl font-bold text-white flex items-center gap-2">
          <span class="text-cyan-400">#</span> Featured Projects
        </h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Project 1 -->
        <a href="/projects/hydrovia" class="group block bg-gray-800/30 border border-gray-800 rounded-2xl overflow-hidden hover:border-cyan-500/50 transition-all">
          <div class="h-48 bg-gray-700/50 relative flex items-center justify-center overflow-hidden">
            <img src="/images/hydrovia/WhatsApp Image 2026-09-27 at 22.55.58.jpeg" alt="Hydrovia" class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity" />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 to-transparent"></div>
          </div>
          <div class="p-6">
            <div class="flex gap-2 mb-3">
              <span class="text-xs font-mono px-2 py-1 bg-cyan-900/40 text-cyan-400 rounded-md">IoT</span>
              <span class="text-xs font-mono px-2 py-1 bg-gray-700 text-gray-300 rounded-md">ESP32</span>
            </div>
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-cyan-400 transition-colors">Hydrovia Smart Pipe</h3>
            <p class="text-gray-400 text-sm line-clamp-2">
              An Industrial IoT system for monitoring water leakage using flow sensors, MQTT telemetry, and a Node-RED dashboard.
            </p>
          </div>
        </a>

        <!-- Project 2 -->
        <a href="/projects/almasena" class="group block bg-gray-800/30 border border-gray-800 rounded-2xl overflow-hidden hover:border-cyan-500/50 transition-all">
          <div class="h-48 bg-gray-700/50 relative flex items-center justify-center overflow-hidden">
            <img src="/images/voyager/Main_Picture.JPG" alt="Almasena ROV" class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity" />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 to-transparent"></div>
          </div>
          <div class="p-6">
            <div class="flex gap-2 mb-3">
              <span class="text-xs font-mono px-2 py-1 bg-cyan-900/40 text-cyan-400 rounded-md">Robotics</span>
              <span class="text-xs font-mono px-2 py-1 bg-gray-700 text-gray-300 rounded-md">STM32</span>
            </div>
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-cyan-400 transition-colors">Almasena ROV</h3>
            <p class="text-gray-400 text-sm line-clamp-2">
              Semi-autonomous marine vessel featuring PID control loops, Pixhawk telemetry, and robust UDP networking.
            </p>
          </div>
        </a>

        <!-- Project 3 -->
        <a href="/projects/safara" class="group block bg-gray-800/30 border border-gray-800 rounded-2xl overflow-hidden hover:border-cyan-500/50 transition-all">
          <div class="h-48 bg-gray-700/50 relative flex items-center justify-center overflow-hidden">
            <img src="/images/safara/WhatsApp Image 2026-09-27 at 23.03.13 (1).jpeg" alt="Safara Gate" class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity bg-white" />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 to-transparent"></div>
          </div>
          <div class="p-6">
            <div class="flex gap-2 mb-3">
              <span class="text-xs font-mono px-2 py-1 bg-cyan-900/40 text-cyan-400 rounded-md">AI / CV</span>
              <span class="text-xs font-mono px-2 py-1 bg-gray-700 text-gray-300 rounded-md">YOLO & K8s</span>
            </div>
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-cyan-400 transition-colors">Safara Gate</h3>
            <p class="text-gray-400 text-sm line-clamp-2">
              Security checkpoint system enforcing PPE compliance via edge computer vision (YOLO) and IoT hardware.
            </p>
          </div>
        </a>

        <!-- Project 4 -->
        <a href="/projects/voyager" class="group block bg-gray-800/30 border border-gray-800 rounded-2xl overflow-hidden hover:border-cyan-500/50 transition-all">
          <div class="h-48 bg-gray-700/50 relative flex items-center justify-center overflow-hidden">
            <img src="/images/voyager_boat/WhatsApp Image 2026-09-27 at 23.11.11 (1).jpeg" alt="Voyager" class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity" />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 to-transparent"></div>
          </div>
          <div class="p-6">
            <div class="flex gap-2 mb-3">
              <span class="text-xs font-mono px-2 py-1 bg-cyan-900/40 text-cyan-400 rounded-md">Robotics</span>
              <span class="text-xs font-mono px-2 py-1 bg-gray-700 text-gray-300 rounded-md">Arduino & RasPi</span>
            </div>
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-cyan-400 transition-colors">Voyager</h3>
            <p class="text-gray-400 text-sm line-clamp-2">
              A semi-autonomous vessel designed for river trash collection using computer vision and remote control.
            </p>
          </div>
        </a>
      </div>
    </section>
    <!-- SPEAKING & MC SECTION -->
    <section id="pembicara" class="mb-24">
      <div class="flex flex-col gap-2 mb-8">
        <h2 class="text-2xl font-bold text-white flex items-center gap-2">
          <span class="text-cyan-400">#</span> Speaking & MC Experience
        </h2>
        <p class="text-gray-400 text-sm">Documentation of my experiences as a speaker and Master of Ceremonies.</p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Card 1 -->
        <div class="bg-gray-800/30 border border-gray-800 rounded-xl overflow-hidden hover:border-cyan-500/50 transition-all shadow-lg hover:shadow-cyan-500/10 flex flex-col">
          <div class="h-48 bg-gray-700/50 relative shrink-0">
            <img src="/images/pembicara/MC Pionir Gadjah Mada.jpeg" alt="MC Pionir Gadjah Mada" class="absolute inset-0 w-full h-full object-cover opacity-80 hover:opacity-100 transition-opacity" />
          </div>
          <div class="p-4 text-center flex-1 flex flex-col justify-center">
            <h3 class="font-semibold text-gray-200 text-sm">MC - Pionir Gadjah Mada</h3>
            <p class="text-[11px] text-gray-400 mt-1 leading-tight">Master of Ceremonies for UGM's official campus orientation event.</p>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="bg-gray-800/30 border border-gray-800 rounded-xl overflow-hidden hover:border-cyan-500/50 transition-all shadow-lg hover:shadow-cyan-500/10 flex flex-col">
          <div class="h-48 bg-gray-700/50 relative shrink-0">
            <img src="/images/pembicara/MC Wisuda.jpeg" alt="MC Wisuda" class="absolute inset-0 w-full h-full object-cover opacity-80 hover:opacity-100 transition-opacity" />
          </div>
          <div class="p-4 text-center flex-1 flex flex-col justify-center">
            <h3 class="font-semibold text-gray-200 text-sm">MC - Graduation Ceremony</h3>
            <p class="text-[11px] text-gray-400 mt-1 leading-tight">Hosted the university's graduation ceremony events.</p>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="bg-gray-800/30 border border-gray-800 rounded-xl overflow-hidden hover:border-cyan-500/50 transition-all shadow-lg hover:shadow-cyan-500/10 flex flex-col">
          <div class="h-48 bg-gray-700/50 relative shrink-0">
            <img src="/images/pembicara/Pembaca Puisi Peksimiprov UGM.jpeg" alt="Pembaca Puisi Peksimiprov UGM" class="absolute inset-0 w-full h-full object-cover opacity-80 hover:opacity-100 transition-opacity" />
          </div>
          <div class="p-4 text-center flex-1 flex flex-col justify-center">
            <h3 class="font-semibold text-gray-200 text-sm">Poetry Reader - Peksimiprov UGM</h3>
            <p class="text-[11px] text-gray-400 mt-1 leading-tight">Performed poetry reading at the provincial student art week.</p>
          </div>
        </div>

        <!-- Card 4 (KMFM Slider with Buttons) -->
        <image-slider class="bg-gray-800/30 border border-gray-800 rounded-xl overflow-hidden hover:border-cyan-500/50 transition-all shadow-lg hover:shadow-cyan-500/10 group flex flex-col">
          <div class="h-48 bg-gray-700/50 relative overflow-hidden shrink-0">
            <div class="slider-container flex w-full h-full transition-transform duration-300">
              <img src="/images/pembicara/Pembicara KMFM Nyala 1.jpeg" alt="Pembicara KMFM Nyala 1" class="w-full h-full shrink-0 object-cover opacity-80 group-hover:opacity-100 transition-opacity" />
              <img src="/images/pembicara/Pembicara KMFM Nyala 2.jpeg" alt="Pembicara KMFM Nyala 2" class="w-full h-full shrink-0 object-cover opacity-80 group-hover:opacity-100 transition-opacity" />
            </div>
            
            <button class="prev-btn absolute left-2 top-1/2 -translate-y-1/2 bg-black/60 hover:bg-black text-white p-1.5 rounded-full opacity-0 group-hover:opacity-100 transition-opacity disabled:opacity-0 disabled:cursor-not-allowed">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
            </button>
            <button class="next-btn absolute right-2 top-1/2 -translate-y-1/2 bg-black/60 hover:bg-black text-white p-1.5 rounded-full opacity-0 group-hover:opacity-100 transition-opacity disabled:opacity-0 disabled:cursor-not-allowed">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
            </button>
          </div>
          <div class="p-4 text-center border-t border-gray-800/50 flex-1 flex flex-col justify-center">
            <h3 class="font-semibold text-gray-200 text-sm">Speaker - KMFM Nyala</h3>
            <p class="text-[11px] text-gray-400 mt-1 leading-tight">Shared insights and experiences at the KMFM Nyala session.</p>
          </div>
        </image-slider>

        <!-- Card 5 (KMK Slider with Buttons) -->
        <image-slider class="bg-gray-800/30 border border-gray-800 rounded-xl overflow-hidden hover:border-cyan-500/50 transition-all shadow-lg hover:shadow-cyan-500/10 group flex flex-col">
          <div class="h-48 bg-gray-700/50 relative overflow-hidden shrink-0">
            <div class="slider-container flex w-full h-full transition-transform duration-300">
              <img src="/images/pembicara/Pembicara Public Speaking KMK 2.jpeg" alt="Pembicara Public Speaking KMK 2" class="w-full h-full shrink-0 object-cover opacity-80 group-hover:opacity-100 transition-opacity" />
              <img src="/images/pembicara/Pembicara Public Speaking KMK.jpeg" alt="Pembicara Public Speaking KMK" class="w-full h-full shrink-0 object-cover opacity-80 group-hover:opacity-100 transition-opacity" />
            </div>
            
            <button class="prev-btn absolute left-2 top-1/2 -translate-y-1/2 bg-black/60 hover:bg-black text-white p-1.5 rounded-full opacity-0 group-hover:opacity-100 transition-opacity disabled:opacity-0 disabled:cursor-not-allowed">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
            </button>
            <button class="next-btn absolute right-2 top-1/2 -translate-y-1/2 bg-black/60 hover:bg-black text-white p-1.5 rounded-full opacity-0 group-hover:opacity-100 transition-opacity disabled:opacity-0 disabled:cursor-not-allowed">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
            </button>
          </div>
          <div class="p-4 text-center border-t border-gray-800/50 flex-1 flex flex-col justify-center">
            <h3 class="font-semibold text-gray-200 text-sm">Speaker - Public Speaking KMK</h3>
            <p class="text-[11px] text-gray-400 mt-1 leading-tight">Gave training on effective public speaking at KMK.</p>
          </div>
        </image-slider>

        <!-- Card 8 -->
        <div class="bg-gray-800/30 border border-gray-800 rounded-xl overflow-hidden hover:border-cyan-500/50 transition-all shadow-lg hover:shadow-cyan-500/10 flex flex-col">
          <div class="h-48 bg-gray-700/50 relative shrink-0">
            <img src="/images/pembicara/Pembicara UKM Selam.png" alt="Pembicara UKM Selam" class="absolute inset-0 w-full h-full object-cover opacity-80 hover:opacity-100 transition-opacity" />
          </div>
          <div class="p-4 text-center flex-1 flex flex-col justify-center">
            <h3 class="font-semibold text-gray-200 text-sm">Speaker - UKM Selam</h3>
            <p class="text-[11px] text-gray-400 mt-1 leading-tight">Delivered a talk for the University Diving Club.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  class ImageSlider extends HTMLElement {
    constructor() {
      super();
      let currentIndex = 0;
      const container = this.querySelector('.slider-container');
      const prevBtn = this.querySelector('.prev-btn');
      const nextBtn = this.querySelector('.next-btn');
      
      if (!container) return;
      const slideCount = container.children.length;

      const updateSlider = () => {
        container.style.transform = `translateX(-${currentIndex * 100}%)`;
        if (prevBtn) prevBtn.disabled = currentIndex === 0;
        if (nextBtn) nextBtn.disabled = currentIndex === slideCount - 1;
      };

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (currentIndex > 0) currentIndex--;
          updateSlider();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          if (currentIndex < slideCount - 1) currentIndex++;
          updateSlider();
        });
      }

      updateSlider();
    }
  }

  customElements.define('image-slider', ImageSlider);
</script>
